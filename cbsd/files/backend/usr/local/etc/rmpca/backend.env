# Environment variables for the TrashRoute Node.js API server jail.
# This file is sourced by /usr/local/libexec/rmpca-backend at startup.
# deploy.sh rewrites EXTRACT_WS_UPSTREAM and OPTIMIZER_BACKEND_URL with the
# actual jail IPs. All other secrets come from .env.server (copy manually or
# mount via nullfs from the host).

NODE_ENV=production
PORT=3000

# Set by deploy.sh — do not edit by hand
EXTRACT_WS_UPSTREAM=http://10.10.0.2:4000

# Uncomment when the optimizer stack is deployed
# OPTIMIZER_BACKEND_URL=http://10.10.0.7:80
