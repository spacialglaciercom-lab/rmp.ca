# CBSD jail profile: rmpca-extract
# Overture Maps GeoJSON extraction WebSocket service (Node.js 20)
# Port: 4000

jname="rmpca-extract"
host_hostname="rmpca-extract.rmpca.local"
ver="14.2"
baserw="0"

# VNET networking
vnet="1"
ip4_addr="10.10.0.2/24"
gw4="10.10.0.1"

# Security
allow_raw_sockets="1"
mount_devfs="1"
devfs_ruleset="5"

# Lifecycle
exec_start="/bin/sh /etc/rc"
exec_stop="/bin/sh /etc/rc.shutdown"
