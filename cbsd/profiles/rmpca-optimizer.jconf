# CBSD jail profile: rmpca-optimizer
# Python FastAPI optimizer (stateless task enqueueing)
# Port: 8000

jname="rmpca-optimizer"
host_hostname="rmpca-optimizer.rmpca.local"
ver="14.2"
baserw="0"

# VNET networking
vnet="1"
ip4_addr="10.10.0.5/24"
gw4="10.10.0.1"

# Security
allow_raw_sockets="1"
mount_devfs="1"
devfs_ruleset="5"

# Lifecycle
exec_start="/bin/sh /etc/rc"
exec_stop="/bin/sh /etc/rc.shutdown"
