#!/bin/sh
# rmpca-logs — View service logs from rmp.ca CBSD jails.
#
# Usage:
#   rmpca logs extract              Tail extract service logs
#   rmpca logs optimizer            Tail optimizer service logs
#   rmpca logs celery               Tail celery worker logs
#   rmpca logs backend              Tail backend API logs
#   rmpca logs redis                Tail redis logs
#   rmpca logs nginx                Tail nginx-optimizer logs
#   rmpca logs moonshine            Tail moonshine ASR logs
#   rmpca logs all                  Tail all service logs
#
# Options:
#   -f, --follow          Follow log output (like tail -f)
#   -n, --lines N         Number of lines to show (default: 50)
#   --since TIMESTAMP     Show logs since timestamp (if supported)

set -e

SERVICE=""
FOLLOW=0
LINES=50

die()   { printf '\033[1;31mERROR: %s\033[0m\n' "$*" >&2; exit 1; }

usage() {
    sed -n '2,/^$/s/^# \?//p' "$0"
    exit "${1:-0}"
}

while [ $# -gt 0 ]; do
    case "$1" in
        -f|--follow)  FOLLOW=1; shift ;;
        -n|--lines)   LINES="$2"; shift 2 ;;
        -h|--help)    usage 0 ;;
        -*)           die "Unknown option: $1" ;;
        *)
            [ -z "$SERVICE" ] && SERVICE="$1" || die "Unexpected argument: $1"
            shift ;;
    esac
done

[ -z "$SERVICE" ] && die "Service name required. Use: extract, optimizer, celery, backend, redis, nginx, moonshine, all"

# Map service name to jail and log locations
get_jail_and_logs() {
    local svc="$1"
    case "$svc" in
        extract)
            JAIL="rmpca-extract"
            LOG_PATHS="/var/log/extract.log /var/log/messages"
            ;;
        backend)
            JAIL="rmpca-backend"
            LOG_PATHS="/var/log/backend.log /var/log/messages"
            ;;
        optimizer)
            JAIL="rmpca-optimizer"
            LOG_PATHS="/var/log/optimizer.log /var/log/messages"
            ;;
        celery)
            JAIL="rmpca-celery"
            LOG_PATHS="/var/log/celery.log /var/log/messages"
            ;;
        redis)
            JAIL="rmpca-redis"
            LOG_PATHS="/var/log/redis/redis.log /var/log/redis.log /var/log/messages"
            ;;
        nginx)
            JAIL="rmpca-nginx-opt"
            LOG_PATHS="/var/log/nginx/access.log /var/log/nginx/error.log /var/log/messages"
            ;;
        moonshine)
            JAIL="rmpca-moonshine"
            LOG_PATHS="/var/log/moonshine.log /var/log/messages"
            ;;
        *)
            die "Unknown service: $svc. Use: extract, optimizer, celery, backend, redis, nginx, moonshine"
            ;;
    esac
}

tail_logs() {
    local jail="$1" log_paths="$2" svc_name="$3"

    # Check jail is running
    if ! cbsd jls 2>/dev/null | awk '{print $1}' | grep -qx "$jail"; then
        printf '\033[1;33m[%s] Jail not running\033[0m\n' "$svc_name"
        return 1
    fi

    # Find the first log file that exists
    for lp in $log_paths; do
        if cbsd jexec jname="$jail" test -f "$lp" 2>/dev/null; then
            printf '\033[1;34m[%s] %s\033[0m\n' "$svc_name" "$lp"
            if [ "$FOLLOW" -eq 1 ]; then
                cbsd jexec jname="$jail" tail -f -n "$LINES" "$lp"
            else
                cbsd jexec jname="$jail" tail -n "$LINES" "$lp"
            fi
            return 0
        fi
    done

    # Fallback: try to get console output from rc service
    printf '\033[1;33m[%s] No log files found, trying service output...\033[0m\n' "$svc_name"
    cbsd jexec jname="$jail" service "$(echo "$jail" | sed 's/rmpca-//' | sed 's/-opt//')" status 2>&1 || true
}

if [ "$SERVICE" = "all" ]; then
    for svc in extract backend optimizer celery redis nginx moonshine; do
        get_jail_and_logs "$svc"
        echo
        printf '\033[1m━━━ %s (%s) ━━━\033[0m\n' "$svc" "$JAIL"
        tail_logs "$JAIL" "$LOG_PATHS" "$svc" || true
    done
else
    get_jail_and_logs "$SERVICE"
    tail_logs "$JAIL" "$LOG_PATHS" "$SERVICE"
fi
