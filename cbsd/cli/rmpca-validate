#!/bin/sh
# rmpca-validate — Validate a GeoJSON file structure and geometry.
#
# Checks that the file is valid JSON, a FeatureCollection, and that
# geometries are well-formed. Can also hit the backend validation endpoint.
#
# Usage:
#   rmpca validate roads.geojson
#   rmpca validate roads.geojson --remote
#
# Options:
#   INPUT                 Input GeoJSON file
#   --remote              Also validate via the backend API endpoint
#   --host HOST           Backend host (default: $RMPCA_OPTIMIZER_HOST or 10.10.0.7)
#   --port PORT           Port (default: 8000)
#   -q, --quiet           Only output errors (exit code 0=valid, 1=invalid)

set -e

HOST="${RMPCA_OPTIMIZER_HOST:-10.10.0.7}"
PORT="8000"
INPUT=""
REMOTE=0
QUIET=0

info()  { [ "$QUIET" -eq 1 ] || printf '\033[1;32m  ✓ %s\033[0m\n' "$*"; }
warn()  { printf '\033[1;33m  ⚠ %s\033[0m\n' "$*"; }
fail()  { printf '\033[1;31m  ✗ %s\033[0m\n' "$*"; }
die()   { printf '\033[1;31mERROR: %s\033[0m\n' "$*" >&2; exit 1; }

usage() {
    sed -n '2,/^$/s/^# \?//p' "$0"
    exit "${1:-0}"
}

while [ $# -gt 0 ]; do
    case "$1" in
        --remote)    REMOTE=1; shift ;;
        --host)      HOST="$2"; shift 2 ;;
        --port)      PORT="$2"; shift 2 ;;
        -q|--quiet)  QUIET=1; shift ;;
        -h|--help)   usage 0 ;;
        -*)          die "Unknown option: $1" ;;
        *)
            [ -z "$INPUT" ] && INPUT="$1" || die "Unexpected argument: $1"
            shift ;;
    esac
done

[ -z "$INPUT" ] && die "Input GeoJSON file required"
[ -f "$INPUT" ] || die "File not found: $INPUT"

[ "$QUIET" -eq 0 ] && printf '\033[1mValidating: %s\033[0m\n' "$INPUT"

ERRORS=0

python3 -c "
import json, sys, os

input_file = '$INPUT'
remote = $REMOTE == 1
quiet = $QUIET == 1
host = '$HOST'
port = '$PORT'
errors = 0

def ok(s):
    if not quiet:
        print(f'\033[1;32m  OK  {s}\033[0m')

def warn(s):
    print(f'\033[1;33m  WARN  {s}\033[0m')

def fail(s):
    global errors
    errors += 1
    print(f'\033[1;31m  FAIL  {s}\033[0m')

# 1. Valid JSON
try:
    with open(input_file) as f:
        data = json.load(f)
    ok('Valid JSON')
except json.JSONDecodeError as e:
    fail(f'Invalid JSON: {e}')
    sys.exit(1)

# 2. Is a FeatureCollection
if data.get('type') != 'FeatureCollection':
    fail(f'Not a FeatureCollection (type={data.get(\"type\", \"missing\")})')
else:
    ok('type: FeatureCollection')

# 3. Has features
features = data.get('features', [])
if not isinstance(features, list):
    fail('features is not an array')
    sys.exit(1)
elif len(features) == 0:
    warn('Empty FeatureCollection (0 features)')
else:
    ok(f'{len(features)} features')

# 4. Geometry checks
geom_types = {}
bad_geom = 0
empty_coords = 0
for i, feat in enumerate(features):
    if not isinstance(feat, dict):
        fail(f'Feature [{i}] is not an object')
        continue
    geom = feat.get('geometry')
    if geom is None:
        bad_geom += 1
        continue
    gt = geom.get('type', 'missing')
    geom_types[gt] = geom_types.get(gt, 0) + 1
    coords = geom.get('coordinates')
    if coords is None or (isinstance(coords, list) and len(coords) == 0):
        empty_coords += 1

if geom_types:
    ok(f'Geometry types: {geom_types}')
if bad_geom > 0:
    warn(f'{bad_geom} features with null geometry')
if empty_coords > 0:
    warn(f'{empty_coords} features with empty coordinates')

# 5. LineString coordinate count
line_features = [f for f in features if f.get('geometry', {}).get('type') == 'LineString']
if line_features:
    short = sum(1 for f in line_features if len(f['geometry'].get('coordinates', [])) < 2)
    if short > 0:
        warn(f'{short} LineStrings with < 2 coordinates')
    else:
        ok(f'All {len(line_features)} LineStrings have >= 2 coordinates')

# 6. File size
file_size = os.path.getsize(input_file)
if file_size > 50 * 1024 * 1024:
    warn(f'Large file: {file_size / 1024 / 1024:.1f} MB (may exceed API limits)')
else:
    ok(f'File size: {file_size / 1024:.1f} KB')

# 7. Remote validation
if remote:
    try:
        from urllib.request import Request, urlopen
        from urllib.error import HTTPError, URLError

        url = f'http://{host}:{port}/api/geojson/validate'
        payload = json.dumps({'geojson': data}).encode('utf-8')
        req = Request(url, data=payload, headers={'Content-Type': 'application/json'})
        resp = urlopen(req, timeout=30)
        result = json.loads(resp.read().decode('utf-8'))
        if result.get('valid', False):
            ok(f'Remote validation passed: {result.get(\"message\", \"valid\")}')
        else:
            fail(f'Remote validation failed: {result.get(\"errors\", result)}')
    except HTTPError as e:
        fail(f'Remote validation HTTP {e.code}: {e.read().decode(\"utf-8\", errors=\"replace\")}')
    except URLError as e:
        warn(f'Could not reach backend: {e.reason}')
    except Exception as e:
        warn(f'Remote validation error: {e}')

# Summary
if not quiet:
    print()
    if errors == 0:
        print('\033[1;32mValidation passed.\033[0m')
    else:
        print(f'\033[1;31mValidation failed with {errors} error(s).\033[0m')

sys.exit(1 if errors > 0 else 0)
"
