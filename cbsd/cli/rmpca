#!/bin/sh
# rmpca — Unified CLI for rmp.ca FreeBSD jail operations.
#
# Usage:
#   rmpca <command> [args...]
#
# Commands:
#   extract-overture  Extract Overture Maps road data for a bounding box or polygon
#   extract-osm       Download & convert OSM data to GeoJSON for a bounding box
#   optimize          Optimize a GeoJSON route via the Python optimizer jail
#   clean             Clean/repair GeoJSON (dedupe, remove self-loops, etc.)
#   validate          Validate a GeoJSON file structure and geometry
#   pipeline          End-to-end: extract → clean → optimize → GPX export
#   status            Show health/status of all rmp.ca jails and services
#   logs              Tail service logs from a jail
#   help              Show this help message
#
# Environment:
#   RMPCA_EXTRACT_HOST   Extract jail address   (default: 10.10.0.2)
#   RMPCA_BACKEND_HOST   Backend jail address   (default: 10.10.0.3)
#   RMPCA_OPTIMIZER_HOST Optimizer nginx address (default: 10.10.0.7)

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

usage() {
    sed -n '2,/^$/s/^# \?//p' "$0"
    exit "${1:-0}"
}

cmd="${1:-help}"
shift 2>/dev/null || true

case "$cmd" in
    extract-overture) exec "${SCRIPT_DIR}/rmpca-extract-overture" "$@" ;;
    extract-osm)      exec "${SCRIPT_DIR}/rmpca-extract-osm"      "$@" ;;
    optimize)         exec "${SCRIPT_DIR}/rmpca-optimize"          "$@" ;;
    clean)            exec "${SCRIPT_DIR}/rmpca-clean"             "$@" ;;
    validate)         exec "${SCRIPT_DIR}/rmpca-validate"          "$@" ;;
    pipeline)         exec "${SCRIPT_DIR}/rmpca-pipeline"          "$@" ;;
    status)           exec "${SCRIPT_DIR}/rmpca-status"            "$@" ;;
    logs)             exec "${SCRIPT_DIR}/rmpca-logs"              "$@" ;;
    help|-h|--help)   usage 0 ;;
    *)
        printf '\033[1;31mUnknown command: %s\033[0m\n' "$cmd" >&2
        usage 1
        ;;
esac
