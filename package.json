{
  "name": "trashroute-mobile",
  "version": "1.0.9",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "main": "expo-router/entry",
  "scripts": {
    "test:spatial": "node -e \"require('./scripts/spatialTest.js')\"",
    "dev": "cross-env CI=1 EXPO_USE_METRO_WORKSPACE_ROOT=1 npx expo start --web --port 19007",
    "dev:clear": "cross-env CI=1 EXPO_USE_METRO_WORKSPACE_ROOT=1 npx expo start --web --port 19007 --clear",
    "dev:server": "cross-env NODE_ENV=development tsx watch server/_core/index.ts",
    "dev:all": "concurrently -k \"npm run dev:server\" \"npm run dev\"",
    "build": "expo export -p web",
    "build:web": "expo export -p web",
    "build:server": "esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=cjs --outdir=dist",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "lint": "expo lint",
    "format": "prettier --write .",
    "test": "vitest run",
    "db:push": "drizzle-kit generate && drizzle-kit migrate",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "go": "expo start --go",
    "mobile": "expo start --clear",
    "mobile:ios": "expo start --clear --ios",
    "mobile:android": "expo start --clear --android",
    "mobile:fresh": "node scripts/clear-expo-cache.js",
    "cache:clear": "node scripts/clear-all-cache.js",
    "cache:clear:bat": "scripts\\clear-cache.bat",
    "expo:clear-login": "scripts\\clear-expo-login-and-certs.bat",
    "mobile:tunnel": "node scripts/run-tunnel.js",
    "start:offline": "expo start --offline",
    "qr": "node scripts/generate_qr.mjs",
    "prebuild:ios": "npx expo prebuild --platform ios",
    "eas:ios": "eas build --platform ios --non-interactive",
    "eas:ios:clean": "eas build --platform ios --non-interactive --clear-cache",
    "eas:ios:dev": "eas build --profile development --platform ios --non-interactive",
    "eas:ios:dev:clean": "eas build --profile development --platform ios --non-interactive --clear-cache",
    "eas-build-pre-install": "node scripts/eas-log-package-manager.js",
    "eas-build-post-install": "sh scripts/eas-ios-macro-trust.sh",
    "postinstall": "node scripts/postinstall.js",
    "lockfile:clean": "node -e \"const fs=require('fs'); try{fs.unlinkSync('package-lock.json');console.log('Removed package-lock.json');}catch(e){if(e.code!=='ENOENT')throw e;} try{fs.unlinkSync('yarn.lock');console.log('Removed yarn.lock');}catch(e){if(e.code!=='ENOENT')throw e;}\""
  },
