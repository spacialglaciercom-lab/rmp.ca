{
  "name": "trashroute-mobile",
  "version": "1.2.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "test:spatial": "tsx scripts/test-spatial.ts",
    "fetch-dem": "cross-env NODE_OPTIONS=--max-old-space-size=8192 tsx scripts/fetch-dem-data.ts",
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=8192 CI=1 EXPO_USE_METRO_WORKSPACE_ROOT=1 npx expo start --web --port 19007",
    "dev:clear": "cross-env NODE_OPTIONS=--max-old-space-size=8192 CI=1 EXPO_USE_METRO_WORKSPACE_ROOT=1 npx expo start --web --port 19007 --clear",
    "dev:local": "bash scripts/dev-local.sh",
    "dev:server": "cross-env \"NODE_OPTIONS=--max-old-space-size=8192 --require ./scripts/load-server-env.js\" NODE_ENV=development tsx watch server/_core/index.ts",
    "dev:extract": "cross-env NODE_OPTIONS=--max-old-space-size=8192 node extract/server.js",
    "dev:all": "concurrently -k \"npm run dev:server\" \"npm run dev:extract\" \"npm run dev\"",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 expo export -p web",
    "build:web": "cross-env NODE_OPTIONS=--max-old-space-size=8192 expo export -p web",
    "build:server": "esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=cjs --outdir=dist",
    "prestart": "pnpm run build:server",
    "start": "node --max-old-space-size=8192 dist/index.js",
    "web": "pnpm run dev",
    "check": "tsc --noEmit",
    "lint": "expo lint",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:services": "tsx scripts/test-extract-and-optimizer.ts",
    "test:integration": "TEST_API_BASE_URL=http://localhost:3000 vitest run server/tests/extract-and-optimizer.test.ts",
    "db:push": "drizzle-kit generate && drizzle-kit migrate",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "go": "expo start --go",
    "mobile": "cross-env NODE_OPTIONS=--max-old-space-size=8192 expo start --clear",
    "mobile:lan": "cross-env NODE_OPTIONS=--max-old-space-size=8192 node scripts/run-mobile-lan.js",
    "mobile:ios": "cross-env NODE_OPTIONS=--max-old-space-size=8192 expo start --clear --ios",
    "mobile:android": "cross-env NODE_OPTIONS=--max-old-space-size=8192 expo start --android --port 8083",
    "mobile:android:emulator": "node scripts/run-android-emulator.js",
    "mobile:fresh": "node scripts/clear-expo-cache.js",
    "cache:clear": "node scripts/clear-all-cache.js",
    "cache:clear:bat": "scripts\\clear-cache.bat",
    "expo:clear-login": "scripts\\clear-expo-login-and-certs.bat",
    "mobile:tunnel": "cross-env NODE_OPTIONS=--max-old-space-size=8192 node scripts/run-tunnel.js",
    "mobile:tunnel:manual": "node scripts/run-ngrok-manual.js",
    "start:offline": "expo start --offline",
    "qr": "node scripts/generate_qr.mjs",
    "prebuild:ios": "npx expo prebuild --platform ios",
    "eas:ios": "eas build --platform ios --non-interactive",
    "eas:ios:clean": "eas build --platform ios --non-interactive --clear-cache",
    "eas:ios:dev": "eas build --profile development --platform ios --non-interactive",
    "eas:ios:dev:clean": "eas build --profile development --platform ios --non-interactive --clear-cache",
    "eas:android": "eas build --platform android --non-interactive",
    "eas:android:preview": "eas build --platform android --profile preview --non-interactive",
    "build:android": "eas build --platform android --non-interactive",
    "eas-build-pre-install": "node scripts/eas-log-package-manager.js",
    "eas-build-post-install": "sh scripts/eas-ios-macro-trust.sh",
    "postinstall": "node scripts/postinstall.js",
    "lockfile:clean": "node -e \"const fs=require('fs'); try{fs.unlinkSync('package-lock.json');console.log('Removed package-lock.json');}catch(e){if(e.code!=='ENOENT')throw e;} try{fs.unlinkSync('yarn.lock');console.log('Removed yarn.lock');}catch(e){if(e.code!=='ENOENT')throw e;}\"",
    "fix:watchers": "bash scripts/check-inotify-limit.sh",
    "build:shared-logic": "./gradlew :shared-logic:assemble"
  },
