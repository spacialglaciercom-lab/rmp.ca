# Cloudflare R2 credentials for PMTiles upload (build-pmtiles.sh, upload-pmtiles-to-r2.sh)
# Copy to .env.r2 and fill in the API token. Do not commit .env.r2.

# From your R2 bucket "routemasterpro" (ENAM):
R2_ACCOUNT_ID=37b94eb1edd1ce06999158bebd2f0a42
R2_BUCKET=routemasterpro

# Endpoint: base URL only (no bucket path). Scripts build this from ACCOUNT_ID if unset.
R2_ENDPOINT=https://37b94eb1edd1ce06999158bebd2f0a42.r2.cloudflarestorage.com

# Create an R2 API token in Cloudflare dashboard (R2 → Manage R2 API Tokens)
# with "Object Read & Write" for this bucket, then paste:
R2_ACCESS_KEY_ID=your_access_key_id_here
R2_SECRET_ACCESS_KEY=your_secret_access_key_here
