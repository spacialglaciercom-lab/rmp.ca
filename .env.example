# ===========================================
# TrashRoute — environment variables
# Copy to .env and fill in values. For deployment see docs/DEPLOYMENT.md.
# ===========================================

# ---------- Local / shared ----------
# API server URL. Web app (Vercel) must set this to your Railway server URL.
EXPO_PUBLIC_API_BASE_URL=

# ---------- Vercel (web app only) ----------
# Set in Vercel project → Settings → Environment Variables.
# API URL (default in code: https://routemasterpro.ca). Override for local or staging.
# EXPO_PUBLIC_API_BASE_URL=https://routemasterpro.ca

# Optional: OAuth / app branding (if using Manus portal)
# EXPO_PUBLIC_OAUTH_PORTAL_URL=
# EXPO_PUBLIC_OAUTH_SERVER_URL=
# EXPO_PUBLIC_APP_ID=

# Optional: maps, weather, etc.
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
# EXPO_PUBLIC_OPENWEATHERMAP_API_KEY=
# EXPO_PUBLIC_OSRM_URL=

# Python/FastAPI Overture route optimizer backend (Chinese Postman solver)
# Default (production): https://rmp-ca-286569721223.europe-west1.run.app
# For local development: http://localhost:8000
# EXPO_PUBLIC_OPTIMIZER_URL=https://rmp-ca-286569721223.europe-west1.run.app

# CORS allowed origins for the FastAPI backend (comma-separated).
# Defaults to "*" (all origins) when unset. Example: https://trashroute-mobile.vercel.app,http://localhost:8081
# ALLOWED_ORIGINS=*

# Mapillary (dashboard only accepts http/https redirect URLs; use your website for native app too)
# Set to your web origin or full callback URL, e.g. https://routemasterpro.ca or https://routemasterpro.ca/mapillary-callback
# EXPO_PUBLIC_MAPILLARY_REDIRECT_URI=https://routemasterpro.ca

# OpenStreetMap OAuth (Maps & Resources → Sign in to OpenStreetMap)
# Create an OAuth2 app at https://www.openstreetmap.org/oauth2/applications
# In the OSM app set Redirect URI to: <scheme>://oauth-callback (e.g. routemasterpro://oauth-callback)
# For web OSM sign-in also add: https://your-domain.com/osm-callback
# EXPO_PUBLIC_OSM_OAUTH_CLIENT_ID=
# EXPO_PUBLIC_OSM_OAUTH_CLIENT_SECRET=

# ---------- Railway (server only) ----------
# Redirect after OAuth login to your Vercel web app.
# WEB_APP_URL=https://trashroute-mobile.vercel.app

# Database and auth (set in Railway)
# DATABASE_URL=
# MONGODB_URI=
# JWT_SECRET=
# OAUTH_SERVER_URL=
# FIREBASE_SERVICE_ACCOUNT=

# Optional: AI, TTS, etc.
# AI_GATEWAY_API_KEY=
# ELEVENLABS_API_KEY=
# MISTRAL_API_KEY=
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=
# GOOGLE_MAPS_API_KEY=
