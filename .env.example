# ===========================================
# TrashRoute — environment variables
# Copy to .env and fill in values.
# Run `docker compose up --build` from Desktop/rmp.ca/ to start all services.
# ===========================================

# ---------- Backend URLs (Docker local) ----------
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_OPTIMIZER_URL=http://localhost:8000
EXPO_PUBLIC_OVERTURE_EXTRACT_URL=http://localhost:4000
# Overture Extract standalone UI (optional): http://localhost:8090

# To route WebSocket via the main backend proxy instead of directly to extract service:
# EXPO_PUBLIC_OVERTURE_WS_BASE=http://localhost:3000

# ---------- Tunnel (mobile on physical device) ----------
# pnpm run mobile:tunnel / npx expo start --tunnel
# Get token at https://dashboard.ngrok.com/get-started/your-authtoken
# NGROK_AUTHTOKEN=
# TUNNEL_MAX_RETRIES=4
# TUNNEL_RETRY_DELAY_MS=5000

# ---------- Optional: OAuth / app branding ----------
# EXPO_PUBLIC_OAUTH_PORTAL_URL=
# EXPO_PUBLIC_OAUTH_SERVER_URL=
# EXPO_PUBLIC_APP_ID=

# ---------- Optional: maps, weather, etc. ----------
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
# EXPO_PUBLIC_OPENWEATHERMAP_API_KEY=
# EXPO_PUBLIC_OSRM_URL=

# CORS allowed origins for the FastAPI backend (comma-separated).
# ALLOWED_ORIGINS=*

# Mapillary
# EXPO_PUBLIC_MAPILLARY_REDIRECT_URI=https://routemasterpro.ca

# OpenStreetMap OAuth
# EXPO_PUBLIC_OSM_OAUTH_CLIENT_ID=
# EXPO_PUBLIC_OSM_OAUTH_CLIENT_SECRET=

# ---------- Server-side secrets (put in .env.server, not here) ----------
# DATABASE_URL=          → set automatically by docker-compose
# OPTIMIZER_BACKEND_URL= → set automatically by docker-compose
# EXTRACT_WS_UPSTREAM=   → set automatically by docker-compose
# JWT_SECRET=
# MONGODB_URI=
# OAUTH_SERVER_URL=
# FIREBASE_SERVICE_ACCOUNT=
# OPENROUTER_API_KEY=
# AI_GATEWAY_API_KEY=
# BUILT_IN_FORGE_API_KEY=
# BUILT_IN_FORGE_API_URL=
# ELEVENLABS_API_KEY=
# MISTRAL_API_KEY=
# MOONSHINE_STT_ENABLED=false
# GOOGLE_MAPS_API_KEY=
