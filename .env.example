# ===========================================
# TrashRoute — environment variables
# Copy to .env and fill in values. For deployment see docs/DEPLOYMENT.md.
# ===========================================

# ---------- Local development (connect to your local backend) ----------
# Run the Node API server (pnpm run dev:server) and point the app at it:
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# If you run the Python optimizer and/or Overture extract locally, set:
# EXPO_PUBLIC_OPTIMIZER_URL=http://localhost:8000
# EXPO_PUBLIC_OVERTURE_EXTRACT_URL=http://localhost:9000
# On the Node server (.env): OPTIMIZER_BACKEND_URL=http://localhost:8000, EXTRACT_WS_UPSTREAM=http://localhost:9000

# ---------- Production / Cloud Run ----------
# Cloud Run URLs (set these for production deployments):
#   EXPO_PUBLIC_API_BASE_URL=https://rmp-ca-286569721223.europe-west1.run.app
#   EXPO_PUBLIC_OPTIMIZER_URL=https://optimizer-286569721223.northamerica-northeast1.run.app
#   EXPO_PUBLIC_OVERTURE_EXTRACT_URL=https://webovertureextract2-286569721223.northamerica-northeast1.run.app
#   EXPO_PUBLIC_OVERTURE_WS_BASE=https://rmp-ca-286569721223.europe-west1.run.app  (WebSocket via main backend proxy)

# ---------- Production / Vercel ----------
# Deployed web app (rmp-ca.vercel.app) uses same-origin by default — no Railway URLs.
# To use a different backend (e.g. your own server), set in Vercel → Project → Settings → Environment Variables:
#   EXPO_PUBLIC_API_BASE_URL=https://your-backend.example.com
#   (Optional) EXPO_PUBLIC_OVERTURE_EXTRACT_URL=... and EXPO_PUBLIC_OPTIMIZER_URL=... if backends differ.

# ---------- Optional overrides (leave unset to use same-origin on web) ----------
# EXPO_PUBLIC_OPTIMIZER_URL=...
# EXPO_PUBLIC_OVERTURE_EXTRACT_URL=...
# EXPO_PUBLIC_OVERTURE_WS_BASE=...   (WebSocket via main backend proxy)
# On the backend server, if proxying to optimizer/extract:
# OPTIMIZER_BACKEND_URL=...
# EXTRACT_WS_UPSTREAM=...

# Tunnel (pnpm run mobile:tunnel / npx expo start --tunnel). Uses project ngrok (no Windows install needed).
# Get token at https://dashboard.ngrok.com/get-started/your-authtoken
# NGROK_AUTHTOKEN=
# If you see "ngrok tunnel took too long to connect", the script auto-retries. Optional:
# TUNNEL_MAX_RETRIES=4
# TUNNEL_RETRY_DELAY_MS=5000
# Other workarounds: clear cache (-c is already used), allow *.ngrok.com / *.ngrok-agent.com in firewall, or run without --tunnel on same Wi‑Fi.

# Optional: OAuth / app branding (if using Manus portal)
# EXPO_PUBLIC_OAUTH_PORTAL_URL=
# EXPO_PUBLIC_OAUTH_SERVER_URL=
# EXPO_PUBLIC_APP_ID=

# Optional: maps, weather, etc.
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
# EXPO_PUBLIC_OPENWEATHERMAP_API_KEY=
# EXPO_PUBLIC_OSRM_URL=

# CORS allowed origins for the FastAPI backend (comma-separated).
# Defaults to "*" (all origins) when unset. Example: https://trashroute-mobile.vercel.app,http://localhost:8081
# ALLOWED_ORIGINS=*

# Mapillary (dashboard only accepts http/https redirect URLs; use your website for native app too)
# Set to your web origin or full callback URL, e.g. https://routemasterpro.ca or https://routemasterpro.ca/mapillary-callback
# EXPO_PUBLIC_MAPILLARY_REDIRECT_URI=https://routemasterpro.ca

# OpenStreetMap OAuth (Maps & Resources → Sign in to OpenStreetMap)
# Create an OAuth2 app at https://www.openstreetmap.org/oauth2/applications
# In the OSM app set Redirect URI to: <scheme>://oauth-callback (e.g. routemasterpro://oauth-callback)
# For web OSM sign-in also add: https://your-domain.com/osm-callback
# EXPO_PUBLIC_OSM_OAUTH_CLIENT_ID=
# EXPO_PUBLIC_OSM_OAUTH_CLIENT_SECRET=

# ---------- Railway (server only) ----------
# Redirect after OAuth login to your Vercel web app.
# WEB_APP_URL=https://trashroute-mobile.vercel.app

# Database and auth (set in Railway)
# DATABASE_URL=
# MONGODB_URI=
# JWT_SECRET=
# OAUTH_SERVER_URL=
# FIREBASE_SERVICE_ACCOUNT=

# ---------- AI chat / voice (mic) — set on the backend (Railway or local server .env) ----------
# For the AI chat bubble and mic: chat uses one of these; transcription uses Moonshine or Forge/Whisper.
# Add at least one of:
#   OPENROUTER_API_KEY=sk-or-...     (https://openrouter.ai — recommended for Co-Pilot chat)
#   AI_GATEWAY_API_KEY=...           (Vercel AI Gateway or similar)
#   BUILT_IN_FORGE_API_KEY=...       (Google AI / Forge — also used for server-side transcription fallback)
#   BUILT_IN_FORGE_API_URL=...       (optional; required for Forge transcription)
# ELEVENLABS_API_KEY=                (optional: TTS and STT fallback)
# MISTRAL_API_KEY=                   (optional: RAG)
# Voice transcription (dedicated Railway Moonshine service): set on main backend only
# MOONSHINE_SIDECAR_URL=http://localhost:8090
# MOONSHINE_STT_ENABLED=false        (optional: set to "false" to disable Moonshine and use Whisper only)
# GOOGLE_MAPS_API_KEY=
