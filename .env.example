# ===========================================
# TrashRoute — environment variables
# Copy to .env and fill in values.
# Run `docker compose up --build` from Desktop/rmp.ca/ to start all services.
# ===========================================
#
# If Node hits "JavaScript heap out of memory", raise the limit (e.g. in .env or shell):
#   NODE_OPTIONS=--max-old-space-size=8192
# (Scripts already use 4096; use 8192 for very large builds or heavy Metro usage.)
#

# ---------- Local development (connect to your local backend) ----------
# Run the Node API server (pnpm run dev:server) or Docker (backend on port 3000) and point the app at it:
# If port 3000 is busy (e.g. another Docker stack), the server may use 8082; then set:
#   EXPO_PUBLIC_API_BASE_URL=http://localhost:8082
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# iOS physical device: "localhost" is the phone, not your computer. Set BOTH of these to your
# computer's LAN IP so the app can reach (1) the API and (2) Metro for JS bundles (same Wi‑Fi required):
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.1.5:3000
#   REACT_NATIVE_PACKAGER_HOSTNAME=192.168.1.5
# Then run: pnpm run mobile  (or pnpm run mobile:lan to auto-detect IP). If you see "Failed to load
# split bundle from URL ... exp.direct", the device can't reach Metro — use LAN (above) instead of tunnel.
# Get your IP: scripts/check-host-ip.sh  or (macOS) ipconfig getifaddr en0

# If you run the Python optimizer and/or Overture extract locally, set:
# EXPO_PUBLIC_OPTIMIZER_URL=http://localhost:8000
# EXPO_PUBLIC_OVERTURE_EXTRACT_URL=http://localhost:9000
# On the Node server (.env): OPTIMIZER_BACKEND_URL=http://localhost:8000, EXTRACT_WS_UPSTREAM=http://localhost:9000
#
# Extract WebSocket (Overture): on web the app talks to the Node server (same-origin), which proxies to the extract service.
# 1. Run the extract service: pnpm run dev:extract  (listens on http://localhost:9000)
# 2. Run the Node server with EXTRACT_WS_UPSTREAM=http://localhost:9000 so it can proxy /ws/extract and /geojson/:hash.
# Leave EXPO_PUBLIC_OVERTURE_EXTRACT_URL unset for web so the app uses the proxy; set it for mobile if connecting directly to extract.

# ---------- Production / Railway / Cloud Run ----------
# Production URLs (set these for deployed environments):
#   EXPO_PUBLIC_API_BASE_URL=https://zooming-insight-backend.up.railway.app
#   EXPO_PUBLIC_OPTIMIZER_URL=https://divine-harmony-optimizer-b5af.up.railway.app
#   EXPO_PUBLIC_OVERTURE_EXTRACT_URL=https://webovertureextract2-286569721223.northamerica-northeast1.run.app
#   EXPO_PUBLIC_OVERTURE_WS_BASE=https://zooming-insight-backend.up.railway.app  (WebSocket via main backend proxy)

# ---------- Production / Frontend Web App ----------
# Deployed web app (rmpca-production.up.railway.app) uses same-origin by default.
# To use a different backend (e.g. your own server), set in your hosting Environment Variables:
#   EXPO_PUBLIC_API_BASE_URL=https://your-backend.example.com
#   (Optional) EXPO_PUBLIC_OVERTURE_EXTRACT_URL=... and EXPO_PUBLIC_OPTIMIZER_URL=... if backends differ.

# ---------- Optional overrides (leave unset to use same-origin on web) ----------
# EXPO_PUBLIC_OPTIMIZER_URL=...
# EXPO_PUBLIC_OVERTURE_EXTRACT_URL=...
# EXPO_PUBLIC_OVERTURE_WS_BASE=...   (WebSocket via main backend proxy)
# On the backend server, if proxying to optimizer/extract:
# OPTIMIZER_BACKEND_URL=...
# EXTRACT_WS_UPSTREAM=...

# Tunnel (pnpm run mobile:tunnel / npx expo start --tunnel). Uses project ngrok (no Windows install needed).
# Get token at https://dashboard.ngrok.com/get-started/your-authtoken
# NGROK_AUTHTOKEN=
# TUNNEL_MAX_RETRIES=4
# TUNNEL_RETRY_DELAY_MS=5000
# For a physical device over tunnel: the app must reach your API. Set EXPO_PUBLIC_API_BASE_URL to a
# public backend (e.g. Cloud Run) or to a second ngrok URL that exposes your Node server (e.g. ngrok http 3000).

# ---------- Optional: OAuth / app branding ----------
# EXPO_PUBLIC_OAUTH_PORTAL_URL=
# EXPO_PUBLIC_OAUTH_SERVER_URL=
# EXPO_PUBLIC_APP_ID=

# ---------- Optional: maps, weather, etc. ----------
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
# EXPO_PUBLIC_OPENWEATHERMAP_API_KEY=
# EXPO_PUBLIC_OSRM_URL=http://localhost:5000  # Self-hosted OSRM (run scripts/setup-osrm.sh first)
# EXPO_PUBLIC_WEB_APP_PASSWORD=   # Optional: password for web/Vercel deployment (if set in Vercel, overrides default)

# CORS allowed origins for the FastAPI backend (comma-separated).
# ALLOWED_ORIGINS=*

# Mapillary
# EXPO_PUBLIC_MAPILLARY_REDIRECT_URI=https://routemasterpro.ca

# Thunderforest map tiles (Transport Dark layer) — https://www.thunderforest.com
# EXPO_PUBLIC_THUNDERFOREST_API_KEY=

# OpenStreetMap OAuth  (register app at https://www.openstreetmap.org/oauth2/applications)
# Redirect URI: http://localhost:3000/osm-callback (local) or https://routemasterpro.ca/osm-callback (prod)
# EXPO_PUBLIC_OSM_OAUTH_CLIENT_ID=    ← public, safe in .env
# OSM_OAUTH_CLIENT_SECRET=            ← server-side only, keep in .env.server / Railway secrets

# ---------- Server-side secrets (put in .env.server, not here) ----------
# DATABASE_URL=          → set automatically by docker-compose
# OPTIMIZER_BACKEND_URL= → set automatically by docker-compose
# EXTRACT_WS_UPSTREAM=   → set automatically by docker-compose
# JWT_SECRET=
# MONGODB_URI=
# OAUTH_SERVER_URL=
# FIREBASE_SERVICE_ACCOUNT=

# ---------- AI chat / voice (mic) — set on the backend (Railway or local server .env) ----------
# For the AI chat bubble and mic: chat uses one of these; transcription uses Moonshine or Forge/Whisper.
# Add at least one of (set on backend: .env.server locally, or Vercel/Railway env):
#
#   Vercel AI Gateway (Primary) — https://vercel.com/ai-gateway
#   AI_GATEWAY_API_KEY=vck_xxx...  (Format: vck_<random_string>)
#   - Unified access to OpenAI, Anthropic, and other LLM providers
#   - Used for: CoPilot chat, route analysis, AI-powered recommendations
#   - Preferred for production deployments
#
#   OpenRouter (Alternative) — https://openrouter.ai
#   OPENROUTER_API_KEY=sk-or-...   (Alternative gateway if Vercel unavailable)
#
#   Optional: route logger middleware
#   ROUTE_LOG_UPLOAD_URL=https://...  (POST JSON logs; e.g. Vercel Blob or S3 webhook)
#   ROUTE_LOG_ANALYZE=true             (extract entities with gpt-4o-mini when true)
#
#   Google AI / Forge (transcription fallback)
#   BUILT_IN_FORGE_API_KEY=...
#   BUILT_IN_FORGE_API_URL=...
#
# ELEVENLABS_API_KEY=                (optional: TTS and STT fallback)
# MISTRAL_API_KEY=                   (optional: RAG)
# Voice transcription (dedicated Railway Moonshine service): set on main backend only
# MOONSHINE_SIDECAR_URL=http://localhost:8090
# MOONSHINE_STT_ENABLED=false        (optional: set to "false" to disable Moonshine and use Whisper only)
# GOOGLE_MAPS_API_KEY=
