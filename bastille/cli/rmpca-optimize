#!/bin/sh
# rmpca-optimize — Optimize a GeoJSON route via the Python optimizer jail.
#
# Sends a GeoJSON FeatureCollection to the optimizer backend and returns
# the optimized route. Can also export the result as GPX.
#
# Usage:
#   rmpca optimize roads.geojson -o optimized.geojson
#   rmpca optimize roads.geojson -o route.gpx --gpx
#   rmpca optimize roads.geojson --sync --clean
#
# Options:
#   INPUT                         Input GeoJSON file (FeatureCollection)
#   -o, --output FILE             Output file (default: stdout as JSON)
#   --gpx                         Export result as GPX instead of GeoJSON
#   --clean                       Clean/repair GeoJSON before optimizing
#   --sync                        Use synchronous endpoint (wait for result)
#   --host HOST                   Optimizer host (default: $RMPCA_OPTIMIZER_HOST or 10.10.0.7)
#   --port PORT                   Optimizer port (default: 8000)
#   --timeout SECS                Request timeout in seconds (default: 120)
#   --turn-left PENALTY           Left turn penalty 0-10 (default: 0)
#   --turn-right PENALTY          Right turn penalty 0-10 (default: 0)
#   --turn-u PENALTY              U-turn penalty 0-10 (default: 0)
#   --depot LAT,LON               Starting depot location
#   --stats                       Print route statistics to stderr
#   -q, --quiet                   Suppress progress output

set -e

OPTIMIZER_HOST="${RMPCA_OPTIMIZER_HOST:-10.10.0.7}"
OPTIMIZER_PORT="8000"
OUTPUT=""
INPUT=""
GPX=0
CLEAN=0
SYNC=1
TIMEOUT=120
TURN_LEFT="0"
TURN_RIGHT="0"
TURN_U="0"
DEPOT=""
STATS=0
QUIET=0

info()  { [ "$QUIET" -eq 1 ] || printf '\033[1;34m==> %s\033[0m\n' "$*" >&2; }
die()   { printf '\033[1;31mERROR: %s\033[0m\n' "$*" >&2; exit 1; }

usage() {
    sed -n '2,/^$/s/^# \?//p' "$0"
    exit "${1:-0}"
}

while [ $# -gt 0 ]; do
    case "$1" in
        -o|--output)     OUTPUT="$2"; shift 2 ;;
        --gpx)           GPX=1; shift ;;
        --clean)         CLEAN=1; shift ;;
        --sync)          SYNC=1; shift ;;
        --host)          OPTIMIZER_HOST="$2"; shift 2 ;;
        --port)          OPTIMIZER_PORT="$2"; shift 2 ;;
        --timeout)       TIMEOUT="$2"; shift 2 ;;
        --turn-left)     TURN_LEFT="$2"; shift 2 ;;
        --turn-right)    TURN_RIGHT="$2"; shift 2 ;;
        --turn-u)        TURN_U="$2"; shift 2 ;;
        --depot)         DEPOT="$2"; shift 2 ;;
        --stats)         STATS=1; shift ;;
        -q|--quiet)      QUIET=1; shift ;;
        -h|--help)       usage 0 ;;
        -*)              die "Unknown option: $1" ;;
        *)
            [ -z "$INPUT" ] && INPUT="$1" || die "Unexpected argument: $1"
            shift ;;
    esac
done

[ -z "$INPUT" ] && die "Input GeoJSON file required"
[ -f "$INPUT" ] || die "File not found: $INPUT"

OPTIMIZER_URL="http://${OPTIMIZER_HOST}:${OPTIMIZER_PORT}"

info "Optimizing: ${INPUT}"
info "Optimizer: ${OPTIMIZER_URL}"

# Build the request payload
OPTIMIZE_SCRIPT=$(cat <<'PYEOF'
import json, sys, os
try:
    from urllib.request import Request, urlopen
    from urllib.error import HTTPError, URLError
except ImportError:
    print("ERROR: Python urllib required", file=sys.stderr)
    sys.exit(1)

input_file = sys.argv[1]
base_url = sys.argv[2]
timeout = int(sys.argv[3])
clean = sys.argv[4] == "1"
gpx = sys.argv[5] == "1"
output = sys.argv[6] if sys.argv[6] != "" else None
turn_left = float(sys.argv[7])
turn_right = float(sys.argv[8])
turn_u = float(sys.argv[9])
depot_str = sys.argv[10]
show_stats = sys.argv[11] == "1"
quiet = sys.argv[12] == "1"

def log(s):
    if not quiet:
        print(f"\033[1;34m==> {s}\033[0m", file=sys.stderr)

with open(input_file) as f:
    geojson = json.load(f)

if geojson.get("type") != "FeatureCollection":
    print("ERROR: Input must be a GeoJSON FeatureCollection", file=sys.stderr)
    sys.exit(1)

n_features = len(geojson.get("features", []))
log(f"Input: {n_features} features")

# Build optimize request
payload = {
    "geojson": geojson,
    "clean_before_optimize": clean,
}

if turn_left > 0 or turn_right > 0 or turn_u > 0:
    payload["turn_penalties"] = {
        "left_turn": turn_left,
        "right_turn": turn_right,
        "u_turn": turn_u,
    }

if depot_str:
    lat, lon = depot_str.split(",")
    payload["depot"] = {"lat": float(lat), "lon": float(lon)}

# Send to optimizer
url = f"{base_url}/api/optimize/sync"
data = json.dumps(payload).encode("utf-8")
log(f"Sending {len(data)} bytes to {url}...")

try:
    req = Request(url, data=data, headers={"Content-Type": "application/json"})
    resp = urlopen(req, timeout=timeout)
    result = json.loads(resp.read().decode("utf-8"))
except HTTPError as e:
    body = e.read().decode("utf-8", errors="replace")
    print(f"ERROR: HTTP {e.code}: {body}", file=sys.stderr)
    sys.exit(1)
except URLError as e:
    print(f"ERROR: Cannot connect to optimizer: {e.reason}", file=sys.stderr)
    print("Is the optimizer jail running? Check: rmpca status", file=sys.stderr)
    sys.exit(1)

# Print stats
if show_stats or not quiet:
    stats = result.get("stats", {})
    log(f"Total distance: {result.get('total_distance_km', '?')} km")
    log(f"Efficiency: {stats.get('efficiency', '?')}%")
    log(f"Deadhead: {stats.get('deadhead_distance_km', '?')} km")
    log(f"Total traversals: {stats.get('total_traversals', '?')}")
    turns = stats.get("turn_summary", {})
    if turns:
        log(f"Turns — L:{turns.get('left_turns',0)} R:{turns.get('right_turns',0)} U:{turns.get('u_turns',0)} Straight:{turns.get('straight',0)}")

# Output
if gpx:
    # Convert ordered route to GPX
    route_coords = result.get("ordered_route", [])
    gpx_xml = ['<?xml version="1.0" encoding="UTF-8"?>']
    gpx_xml.append('<gpx version="1.1" creator="rmpca-optimize">')
    gpx_xml.append('  <trk><name>Optimized Route</name><trkseg>')
    for coord in route_coords:
        if isinstance(coord, list) and len(coord) >= 2:
            gpx_xml.append(f'    <trkpt lat="{coord[1]}" lon="{coord[0]}" />')
        elif isinstance(coord, dict):
            gpx_xml.append(f'    <trkpt lat="{coord.get("lat", coord.get("1",""))}" lon="{coord.get("lon", coord.get("0",""))}" />')
    gpx_xml.append('  </trkseg></trk>')
    gpx_xml.append('</gpx>')
    out_text = "\n".join(gpx_xml)
else:
    out_text = json.dumps(result, indent=2)

if output:
    with open(output, "w") as f:
        f.write(out_text)
    log(f"Output: {output}")
else:
    print(out_text)
PYEOF
)

python3 -c "$OPTIMIZE_SCRIPT" \
    "$INPUT" \
    "$OPTIMIZER_URL" \
    "$TIMEOUT" \
    "$CLEAN" \
    "$GPX" \
    "$OUTPUT" \
    "$TURN_LEFT" \
    "$TURN_RIGHT" \
    "$TURN_U" \
    "$DEPOT" \
    "$STATS" \
    "$QUIET"
