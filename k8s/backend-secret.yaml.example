# DO NOT commit the real backend-secret.yaml — this is a template only.
# Create the real secret with:
#
#   kubectl create secret generic backend-secret \
#     --namespace=rmpca \
#     --from-env-file=.env.server
#
# Or apply this file after filling in base64-encoded values:
#   echo -n 'your-value' | base64
apiVersion: v1
kind: Secret
metadata:
  name: backend-secret
  namespace: rmpca
type: Opaque
stringData:
  DATABASE_URL: "postgresql://postgres:PASSWORD@HOST:5432/postgres"
  JWT_SECRET: "change-me-to-a-long-random-string"
  OPENROUTER_API_KEY: "sk-or-..."
  # Optional keys — add as needed:
  # AI_GATEWAY_API_KEY: ""
  # ELEVENLABS_API_KEY: ""
  # GOOGLE_MAPS_API_KEY: ""
  # MONGODB_URI: ""
  # FIREBASE_SERVICE_ACCOUNT: ""
  # MOONSHINE_SIDECAR_URL: ""
  # OSRM_URL: "http://osrm.rmpca.svc.cluster.local:5000"  # Backend OSRM; app uses this instead of public router.project-osrm.org when set
