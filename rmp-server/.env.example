# Environment variables for RMP Rust server
# Copy to .env.server and fill in values

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/rmp

# Auth
JWT_SECRET=your-jwt-secret-here
OAUTH_SERVER_URL=https://your-oauth-server.com
OWNER_OPEN_ID=

# Firebase
FIREBASE_SERVICE_ACCOUNT=

# API Keys
GOOGLE_MAPS_API_KEY=
AI_GATEWAY_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
ELEVENLABS_API_KEY=

# Services
OSRM_URL=
OPTIMIZER_BACKEND_URL=https://divine-harmony-optimizer.up.railway.app

# Email
RESEND_API_KEY=
EMAIL_FROM=RouteMaster Pro <contact@routemasterpro.ca>

# OSM OAuth
OSM_OAUTH_CLIENT_SECRET=

# Other
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
MOONSHINE_SIDECAR_URL=
ROUTE_LOG_UPLOAD_URL=
GPX_TRAINING_PATH=
MONGODB_URI=
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
APP_BASE_URL=http://localhost:3000
