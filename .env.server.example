# Server-side secrets for docker compose (backend service).
# Copy to .env.server and fill in values — this file is NOT loaded by Expo.
# DATABASE_URL, OPTIMIZER_BACKEND_URL and VROOM_BACKEND_URL are already set via docker-compose.yml.
# For local dev without docker-compose, set manually:
#   OPTIMIZER_BACKEND_URL=http://localhost:8000
#   VROOM_BACKEND_URL=http://localhost:3004

# Supabase PostgreSQL — use the DATABASE PASSWORD from Project Settings → Database (not anon/service key).
# If password has @ # % & = etc., URL-encode (e.g. @ → %40). Test with: DOTENV_CONFIG_PATH=.env.server npx tsx scripts/test-postgres.ts
# Direct (port 5432):
#   DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.duxyxrckizbndjqftzar.supabase.co:5432/postgres
# Pooler (port 6543) — user must be postgres.PROJECT_REF:
#   DATABASE_URL=postgresql://postgres.duxyxrckizbndjqftzar:[YOUR-PASSWORD]@aws-0-us-west-2.pooler.supabase.com:6543/postgres

JWT_SECRET=change-me-to-a-long-random-string

# AI / voice (at least one required for Co-Pilot chat)
OPENROUTER_API_KEY=sk-or-...

# Vercel AI Gateway (Primary) — Get your key from https://vercel.com/ai-gateway
# Format: vck_<random_string> — Used for CoPilot, route analysis, AI recommendations
# This is the preferred gateway for production (unified access to OpenAI, Anthropic, etc.)
AI_GATEWAY_API_KEY=

# Optional: route logger middleware (captures prompt + output, uploads in background)
# ROUTE_LOG_UPLOAD_URL=https://... (POST JSON; e.g. Vercel Blob or S3 webhook)
# ROUTE_LOG_ANALYZE=true             (extract entities with gpt-4o-mini when true)
# BUILT_IN_FORGE_API_KEY=
# BUILT_IN_FORGE_API_URL=
# ELEVENLABS_API_KEY=
# MISTRAL_API_KEY=

# Optional
# MONGODB_URI=mongodb://localhost:27017/trashroute
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# GOOGLE_MAPS_API_KEY=
# MOONSHINE_SIDECAR_URL=
# WEB_APP_URL=http://localhost:8081

# Zilliz / Milvus Vector Database
MILVUS_URI=https://in03-3cdb1025e8f14af.serverless.aws-eu-central-1.cloud.zilliz.com
MILVUS_TOKEN=9c92c8b1b0e18158dc868bd2c366d829d76705d9c451fc2ac19c1e0a284c5f17c0b1b0d0ab65f114fd14d9b0abb56e54cfe06558
