# Server-side secrets for docker compose (backend service).
# Copy to .env.server and fill in values — this file is NOT loaded by Expo.
# DATABASE_URL and OPTIMIZER_BACKEND_URL are already set via docker-compose.yml.

# Supabase PostgreSQL — use the DATABASE PASSWORD from Project Settings → Database (not anon/service key).
# If password has @ # % & = etc., URL-encode (e.g. @ → %40). Test with: DOTENV_CONFIG_PATH=.env.server npx tsx scripts/test-postgres.ts
# Direct (port 5432):
#   DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.duxyxrckizbndjqftzar.supabase.co:5432/postgres
# Pooler (port 6543) — user must be postgres.PROJECT_REF:
#   DATABASE_URL=postgresql://postgres.duxyxrckizbndjqftzar:[YOUR-PASSWORD]@aws-0-us-west-2.pooler.supabase.com:6543/postgres

JWT_SECRET=change-me-to-a-long-random-string

# AI / voice (at least one required for Co-Pilot chat)
OPENROUTER_API_KEY=sk-or-...
# AI_GATEWAY_API_KEY=
# BUILT_IN_FORGE_API_KEY=
# BUILT_IN_FORGE_API_URL=
# ELEVENLABS_API_KEY=
# MISTRAL_API_KEY=

# Optional
# MONGODB_URI=mongodb://localhost:27017/trashroute
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# GOOGLE_MAPS_API_KEY=
# MOONSHINE_SIDECAR_URL=
# WEB_APP_URL=http://localhost:8081
